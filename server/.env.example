# ==========================================
# DevSync Backend Environment Variables (.env)
# Place this file in the /server folder
# ==========================================

# Server Port
PORT=5000

# Environment Mode: 'development', 'production', or 'test'
# Note: In development mode, OTP code is also logged to terminal
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/devsync

# JWT Authentication Secret Key (Replace with a secure random string)
JWT_SECRET=devsync_super_secret_jwt_key_2026

# Frontend Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Email Service Configuration (Nodemailer Gmail SMTP)
# Used for OTP verification during signup & password reset
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="DevSync Platform" <your_email@gmail.com>
